    }
    resp_param->dev_status.current_inj_id = g_current_running_inj_id;

    // task_id匹配逻辑不变
    if(g_tcp_task_bind.bind_inj_id != 0 && g_current_running_inj_id != 0 && g_tcp_task_bind.bind_inj_id == g_current_running_inj_id)
