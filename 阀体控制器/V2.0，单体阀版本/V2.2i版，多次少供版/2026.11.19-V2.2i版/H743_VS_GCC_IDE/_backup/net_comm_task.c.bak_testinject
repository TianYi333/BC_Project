/**
 * @brief 统一封装失败 execute_result 上报（错误码 + 描述）
 * @param task_id 任务 ID
 * @param inj_id 注油口 ID 1~8
 * @param err_code 错误码
 * @param err_msg 错误描述字符串
 */
static void tcp_report_fail(const char *task_id, uint8_t inj_id, uint8_t err_code, const char *err_msg)
{
    ExecuteResultInfo_t exec_info; // 局部变量，栈内分配，无并发风险
    memset(&exec_info, 0, sizeof(exec_info));

    // 安全拷贝task_id
    if (task_id != NULL)
    {
        strncpy(exec_info.task_id, task_id, sizeof(exec_info.task_id) - 1);
    }
    else
    {
        strncpy(exec_info.task_id, "0", sizeof(exec_info.task_id) - 1);
    }
    exec_info.task_id[sizeof(exec_info.task_id) - 1] = '\0';

    exec_info.inj_id = inj_id;
    exec_info.actual_volume = 0;
    exec_info.valve_act_tm = 0;
    exec_info.valve_total_tm = 0;

    // 读取TimeSyncTask定时刷新的全局温湿度缓存（放大10倍整型）
    exec_info.valve_temp = g_sht40_temp_cache;
    exec_info.valve_hum  = g_sht40_hum_cache;

    exec_info.execute_result = 3;
    exec_info.error_code = err_code;
    strncpy(exec_info.error_msg, err_msg, sizeof(exec_info.error_msg) - 1);
    exec_info.error_msg[sizeof(exec_info.error_msg) - 1] = '\0';

    tcp_send_execute_result(&exec_info, 1U);
}


/**
 * @brief 消费 xTcpTaskQueue：校验就绪/忙、更新配置、投递注油任务
 * @param argument FreeRTOS 线程参数（未使用）
 */
void TCP_task_processing_task(void *argument)
{
    TaskInfo_t recv_item={0};
    memset(&task_object_list[3], 0, sizeof(_TASK_OBJECT));//将任务列表3清零
    while(1)
    {
        if(xQueueReceive(xTcpTaskQueue, &recv_item, portMAX_DELAY) == pdPASS)
        {
            // 只有系统就绪模式才处理任务，其他模式直接丢弃
            if(main_sys_status.running_mode != SYS_MODE_READY)
            {
                LOG_NET("System not ready mode, discard tcp task: inj= %u; vol= %lu; inj_ts= %lu; task_id= %s\r\n",
                    recv_item.inj_id, (unsigned long)recv_item.inj_v, (unsigned long)recv_item.inj_ts, recv_item.task_id);
//-------------------------------失败上报------------------------------------------------------------------------------------------------    
                tcp_report_fail(recv_item.task_id, recv_item.inj_id, 6, "The system is not ready !");
//-------------------------------------------------------------------------------------------------------------------------------
                continue;
            }

            if(main_sys_status.is_Busy)
            {
                LOG_NET("System busy, discard tcp task: inj= %u; vol= %lu; inj_ts= %lu; task_id= %s\r\n",
                    recv_item.inj_id, (unsigned long)recv_item.inj_v, (unsigned long)recv_item.inj_ts, recv_item.task_id);
//-------------------------------失败上报------------------------------------------------------------------------------------------------    
                tcp_report_fail(recv_item.task_id, recv_item.inj_id, 7, "The system is busy !");
//-------------------------------------------------------------------------------------------------------------------------------
                continue;
            }

//             if(main_sys_status.p_model.status != MOTOR_STATUS_READY || main_sys_status.q_model.motor_status != MOTOR_STATUS_READY || main_sys_status.q_model.sen_status != SENSOR_STATUS_READY)//P、Q、传感器未就绪
//             {
