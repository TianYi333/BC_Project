/**
 * @brief TCP 收包回调：拼接 pbuf、交 tcp_parse_cmd、处理对端 FIN
 * @param arg 回调用户参数（未使用）
 * @param tpcb 接收数据的 TCP PCB
 * @param p 收到的 pbuf 链；NULL 表示对端 FIN
 * @param err 接收状态错误码
 * @retval ERR_OK=正常处理 ERR_CLSD=连接关闭
 */
static err_t tcp_recv_cb(void *arg, struct tcp_pcb *tpcb, struct pbuf *p, err_t err)
{
    if(err != ERR_OK || p == NULL)
    {
        tcp_pending_close = 1;
        g_tcp_connected = 0;
        if(err != ERR_OK)
        {
            // 异常路径：lwIP 将自行释放该 pcb，必须立即清空全局指针避免 UAF
            tcp_pcb = NULL;
        }
        /* 对端优雅 FIN（p==NULL 且 err==ERR_OK）：lwIP 不会自动释放 pcb，
         * 必须由应用 tcp_close。此处故意不清空 tcp_pcb，留给主循环
         * safe_tcp_close() 按全局指针真正关闭释放，避免留下 CLOSE_WAIT
         * 孤儿连接（即之前“PC 看到两条连接 / 设备打印两条 / 心跳只一条 /
         * 重连只断一条”的根因）。 */
        return ERR_CLSD;
    }

    memset(tcp_rx_buf, 0, RX_BUF_SIZE);
    // p 可能是多段 pbuf 链，必须按 tot_len 处理，否则尾部段被丢弃且接收窗口少报
    uint16_t recv_len = (p->tot_len < (RX_BUF_SIZE - 1)) ? p->tot_len : (RX_BUF_SIZE - 1);
    pbuf_copy_partial(p, tcp_rx_buf, recv_len, 0);

    tcp_parse_cmd(tpcb, tcp_rx_buf);
    // 通知lwIP接收缓冲区已处理，释放pbuf内存（按整条链长度通告，避免窗口枯竭）
    tcp_recved(tpcb, p->tot_len);
    pbuf_free(p);

    return ERR_OK;
}


