/**
 * @brief 上报升级结果；未连网则缓存到 FlashDB 待补发
 * @param result 升级结果（0=成功）
 * @param message 结果描述字符串
 */
void tcp_report_upgrade_result(uint8_t result, const char *message)
{
    ota_result_blob_t blob_data = {0};
    blob_data.magic      = OTA_RESULT_MAGIC;
    blob_data.result     = result;
    if (message)   strncpy(blob_data.message,   message,   sizeof(blob_data.message)   - 1);
    strncpy(blob_data.new_version, DEVICE_FW_VER, sizeof(blob_data.new_version) - 1);

    if (tcp_pcb == NULL || g_tcp_connected != 1)
    {
        struct fdb_blob blob_obj;
        fdb_blob_t blob = &blob_obj;
        blob->buf = (uint8_t *)&blob_data;
        blob->size = sizeof(blob_data);
        taskENTER_CRITICAL();
        fdb_kv_set_blob(&reboot_kvdb, KV_KEY_OTA_RESULT, blob);
        taskEXIT_CRITICAL();
        LOG_NET("ota result pending (not connected), cached\r\n");
        g_ota_result_pending = 1;
        return;
    }
    send_upgrade_result_now(&blob_data);
}


/**
 * @brief TCP 连上后补发缓存的 upgrade_result 并清缓存
 */
void upgrade_result_check_and_report(void)
{
    ota_result_blob_t info = {0};
    struct fdb_blob blob_obj;
    fdb_blob_t blob = &blob_obj;
    blob->buf = (uint8_t *)&info;
    blob->size = sizeof(info);

    size_t read_len = fdb_kv_get_blob(&reboot_kvdb, KV_KEY_OTA_RESULT, blob);
    if (read_len == 0)
    {
        g_ota_result_pending = 0;
        return;
    }
    if (info.magic != OTA_RESULT_MAGIC)
    {
        fdb_kv_del(&reboot_kvdb, KV_KEY_OTA_RESULT);
        g_ota_result_pending = 0;
        return;
    }
    send_upgrade_result_now(&info);
    fdb_kv_del(&reboot_kvdb, KV_KEY_OTA_RESULT);
    g_ota_result_pending = 0;
    LOG_NET("upgrade_result flushed after connect\r\n");
}


