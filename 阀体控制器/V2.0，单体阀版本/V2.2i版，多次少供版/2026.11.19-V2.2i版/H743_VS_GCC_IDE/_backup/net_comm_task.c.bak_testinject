        return;

    cJSON *root = cJSON_CreateObject();
    cJSON *inj_arr = cJSON_CreateArray();
    uint64_t ts = Get_Unix_Second();

    StateRespParam_t temp_param;
    FillCommonDeviceStatus(&temp_param);
    // 循环填充全部出油口，内部字段严格字典序
    for(uint16_t i = 0; i < INJECTOR_CNT; i++)
    {
        InjectorItem_t item = {0};
        FillSingleInjectorItem(&item, i);
        cJSON *obj = cJSON_CreateObject();
        cJSON_AddNumberToObject(obj, "inj_acvs",        item.inj_acvs);
        cJSON_AddNumberToObject(obj, "inj_id",          item.inj_id);
        cJSON_AddNumberToObject(obj, "inj_ts",          item.inj_ts);
        cJSON_AddNumberToObject(obj, "inj_vs",          item.inj_vs);
        cJSON_AddNumberToObject(obj, "last_error_code", item.last_error_code);
        cJSON_AddStringToObject(obj, "last_error_msg",  item.last_error_msg);
        cJSON_AddNumberToObject(obj, "progress_ts",     item.progress_ts);
        cJSON_AddNumberToObject(obj, "status",          item.status);
        cJSON_AddItemToArray(inj_arr, obj);
    }

    // device_status子对象，内部字段字典序
    cJSON *dev_st = cJSON_CreateObject();
    cJSON_AddNumberToObject(dev_st, "current_inj_id",    temp_param.dev_status.current_inj_id);
    cJSON_AddStringToObject(dev_st, "current_task_id",  temp_param.dev_status.current_task_id);
    cJSON_AddNumberToObject(dev_st, "current_task_start",temp_param.dev_status.current_task_start);
    cJSON_AddNumberToObject(dev_st, "estimated_complete",temp_param.dev_status.estimated_complete);
    cJSON_AddBoolToObject(dev_st, "is_oiling", temp_param.dev_status.is_oiling ? cJSON_True : cJSON_False);

    // 顶层字典序（不含sign）
    cJSON_AddStringToObject(root, "device_id", g_device_id);
    cJSON_AddItemToObject(root, "device_status", dev_st);
    cJSON_AddItemToObject(root, "injectors", inj_arr);
    cJSON_AddNumberToObject(root, "run_status", temp_param.run_status);
    cJSON_AddNumberToObject(root, "seq", g_tcp_seq);
    cJSON_AddNumberToObject(root, "ts", ts);
    cJSON_AddStringToObject(root, "type", "state_response");

    // 生成无签名字符串用于HMAC计算
    char *json_without_sign = cJSON_PrintUnformatted(root);
    if (!json_without_sign) {
        cJSON_Delete(root);
        return;
    }
    // HMAC签名计算
    uint8_t hash[32];
    HMAC_SHA256_CTX hmac;
    hmac_sha256_init(&hmac, (const uint8_t *)HMAC_KEY, strlen(HMAC_KEY));
    hmac_sha256_update(&hmac, (const uint8_t *)json_without_sign, strlen(json_without_sign));
    hmac_sha256_final(&hmac, hash);
    char sign_str[9];
    snprintf(sign_str, sizeof(sign_str), "%02X%02X%02X%02X", hash[0], hash[1], hash[2], hash[3]);

    // 仅最后追加sign字段
    cJSON_AddStringToObject(root, "sign", sign_str);
    
    char *str = cJSON_PrintUnformatted(root);
    if(str)
    {
        // 使用队列投递，不再直接调用 tcp_send_str
        tcp_send_msg_t msg;
        msg.data = (char *)pvPortMalloc(strlen(str) + 1);
        if(msg.data) {
            strcpy(msg.data, str);
            if(xQueueSend(tcp_send_queue, &msg, 0) != pdPASS) {
                vPortFree(msg.data);          // 队列满，丢弃
                LOG_NET("TCP send queue full, drop all state_response");
            }
        }
        cJSON_PortFree(str);
        g_tcp_seq++;
    }

    cJSON_PortFree(json_without_sign);
    cJSON_Delete(root);
}


//======================== 阀体供油策略：去重 / 分次调度 helper =============================
// 注油准入判据（统一判据，三处共用）：
//   返回 1 = 允许注油（系统处于 SYS_MODE_READY 就绪模式 且 当前不忙）；
//   返回 0 = 不允许注油。
// 三处共用本判据，但【后续动作各自不同】，语义不合并：
//   ① type1/2/4（TCP_task_processing_task）：不允许 -> 丢弃该任务并 tcp_report_fail（网关可重试）。
//   ② type=3 已排程批次（task_scheduler_task）：不允许 -> 【保留表项】不丢弃，等条件恢复后按原 exec_at 补执行
//      （丢弃 = 少注该批油量；exec_at 可能尚未到达）。
//   ③ 离线自主整轮注油（task_scheduler_task）：不允许 -> 本拍跳过且不推进 last_fire_unix（下拍重试）。
// 说明：SYS_MODE_READY 由电机初始化成功后的 set_mode_if_starting(SYS_MODE_READY) 置位，
//   即设备上电完成自检进入就绪态；其余模式（STARTING/MONITOR/SETTING/AUTO）一律不放行注油。
/**
 * @brief 判断系统就绪且空闲（SYS_MODE_READY && !is_Busy）
 * @retval 1=系统就绪且空闲可注油 0=不允许
 */
static inline uint8_t inject_task_allowed(void)
{
    return (uint8_t)((main_sys_status.running_mode == SYS_MODE_READY) && (main_sys_status.is_Busy == 0));
}


// 去重：同一子任务（task_id + sub_index）是否已处理过（防止重传帧重复注油，契约 §4.2-6 / §6.2）
/**
 * @brief 查询 (task_id, sub_index) 复合键是否已受理（防重传）
 * @param task_id 任务 ID
 * @param sub_index 批次序号（非分次任务为 0）
 * @retval 1=已受理过（重复帧） 0=新任务
 */
static uint8_t dedup_is_duplicate(const char *task_id, uint16_t sub_index)
{
    for(uint8_t i = 0; i < DEDUP_RING_MAX; i++)
    {
        if(g_dedup_ring[i].task_id[0] == '\0') continue; // 空槽
        if(g_dedup_ring[i].sub_index != sub_index) continue;
        if(strncmp(g_dedup_ring[i].task_id, task_id, TASK_ID_LEN - 1) == 0)
            return 1;
    }
    return 0;
}


/**
 * @brief 受理成功后把 (task_id, sub_index) 写入去重环
 * @param task_id 任务 ID
 * @param sub_index 批次序号（非分次任务为 0）
 */
static void dedup_mark(const char *task_id, uint16_t sub_index)
{
    memset(&g_dedup_ring[g_dedup_wpos], 0, sizeof(DedupKey_t));
    strncpy(g_dedup_ring[g_dedup_wpos].task_id, task_id, TASK_ID_LEN - 1);
    g_dedup_ring[g_dedup_wpos].task_id[TASK_ID_LEN - 1] = '\0';
    g_dedup_ring[g_dedup_wpos].sub_index = sub_index;
    g_dedup_wpos = (g_dedup_wpos + 1) % DEDUP_RING_MAX;
}


/**
 * @brief type=3 批次按 exec_at 加入调度表，表满返回 -1
 * @param p 分次任务解析结果
 * @retval 0=入表成功 -1=调度表已满
 */
static int8_t sched_add_split_task(const TaskOrderInfo_t *p)
{
    for(uint8_t i = 0; i < SCHED_MAX; i++)
    {
        if(g_sched_list[i].valid == 0)
        {
            SplitTaskSched_t *s = &g_sched_list[i];
            memset(s, 0, sizeof(SplitTaskSched_t));
            s->valid     = 1;
            s->done      = 0;
            s->inj_id    = p->inj_id;
            s->inj_v     = p->inj_v;
            s->exec_at   = p->exec_at;
            s->sub_index = p->sub_index;
            s->sub_total = p->sub_total;
            strncpy(s->task_id, p->task_id, TASK_ID_LEN - 1);
            s->task_id[TASK_ID_LEN - 1] = '\0';
            return 0;
        }
    }
    return -1;
}


// 解析网关下发指令
// ===================== 协议签名：JSON 键字典序规范化 =====================
// 依据：协议 V2.7 §2.4.1「提取消息中所有字段（排除sign字段）→ 按key字母顺序排序 →
//       构建JSON字符串 → HMAC-SHA256」。
// 契约：
//   ① 排序【对象】的键（key 字节序，strcmp，区分大小写 —— 与网关侧 Go 的
//      sort.Strings / json.Marshal(map) 行为一致）；
//   ② 【不】重排数组元素顺序（数组元素的先后是有语义的，不能排序）；
//   ③ 递归处理嵌套对象。
// 目的：让设备算出的签名原文与网关算出的完全一致，不依赖「报文里键的原始顺序」，
//       避免网关调整字段顺序后设备验签失败。
//
// 注：cJSON 官方版本未提供排序接口，此处自行实现。
//     cJSON 的对象子节点是 child/next/prev 双向链表，重排后必须同步维护 prev。
/**
 * @brief 验签排序用的对象键比较（strcmp 字节序）
 * @param a 待比较的对象键 A
 * @param b 待比较的对象键 B
 * @retval strcmp 字节序语义：<0 / 0 / >0
 */
static int json_key_cmp(const char *a, const char *b)
{
    if(a == NULL && b == NULL) return 0;
    if(a == NULL) return -1;
    if(b == NULL) return 1;
    return strcmp(a, b);
}


// 对单个对象的直接子节点按键做稳定排序（就地重排 child 链表）
// 算法：稳定 selection sort —— 维护两条【独立】链表：
//   rest = 尚未排序的部分（原链），out = 已排好序的部分（结果链）。
//   每轮从 rest 中找出最小节点、摘下后挂到 out 尾部。
// 为何不用「定长数组收集 + 重建」：数组必须有上限，键数超限时尾部节点会被孤立
//   —— 既丢字段（签名串少字段 -> 验签必失败），又因 cJSON_Delete 只沿 next 遍历
//   而永久泄漏（cJSON 走 pvPortMalloc，泄漏会耗尽堆）。
// 为何不用「就地摘链插入」：插入位置搜索会扫回刚插入的节点自身 -> 成环死循环。
// 本算法的两条链各自独立遍历，结构上不可能自环；且零额外缓冲区 -> 无键数上限。
/**
 * @brief 稳定选择排序：重排单个 cJSON 对象的子键
 * @param obj 待按键排序的 cJSON 对象
 */
static void json_sort_object_children(cJSON *obj)
{
    if(obj == NULL || obj->child == NULL) return;

    cJSON *rest     = obj->child;   // 未排序部分
    cJSON *out_head = NULL;         // 已排序部分（头）
    cJSON *out_tail = NULL;         // 已排序部分（尾）

    while(rest != NULL)
    {
        // 在 rest 中找最小节点（相同 key 取最先出现者 -> 稳定）
        cJSON *best      = rest;
        cJSON *best_prev = NULL;
        cJSON *prev      = rest;
        for(cJSON *c = rest->next; c != NULL; prev = c, c = c->next)
        {
            if(json_key_cmp(c->string, best->string) < 0)
            {
                best      = c;
                best_prev = prev;
            }
        }

        // 把 best 从 rest 摘下
        if(best_prev != NULL)
        {
            best_prev->next = best->next;
        }
        else
        {
            rest = best->next;
        }
        if(best->next != NULL)
        {
            best->next->prev = best_prev;
        }
        best->next  = NULL;
        best->prev  = NULL;

        // 挂到 out 尾部
        if(out_tail != NULL)
        {
            out_tail->next = best;
            best->prev     = out_tail;
        }
        else
        {
            out_head      = best;
            best->prev    = NULL;
        }
        out_tail = best;
    }

    obj->child = out_head;
}


/**
 * @brief 递归规范化 JSON：对象按键排序、数组元素保序
 * @param node 待递归规范化的 cJSON 节点
 */
static void json_sort_keys(cJSON *node)
{
    if(node == NULL) return;

    int type = node->type & 0xFF;   // 屏蔽 cJSON_IsReference / cJSON_StringIsConst 标志位

    if(type == cJSON_Object)
    {
        // 先递归子节点，再排本层（子节点排序不依赖本层顺序）
        for(cJSON *c = node->child; c != NULL; c = c->next)
        {
            json_sort_keys(c);
        }
        json_sort_object_children(node);
    }
    else if(type == cJSON_Array)
    {
        // 数组：元素顺序不动，仅递归元素内部的对象
        for(cJSON *c = node->child; c != NULL; c = c->next)
        {
            json_sort_keys(c);
        }
    }
}


/**
 * @brief TCP 入站统一验签并分发下行指令（任务/状态/停止/重启/升级）
 * @param tpcb 当前 TCP PCB
 * @param buf 收到的 JSON 报文字符串
 */
static void tcp_parse_cmd(struct tcp_pcb *tpcb, char *buf)
{
    char *sign_src = NULL;    // 统一指向签名字符串
    cJSON *temp_sign = NULL;
    uint16_t req_inj_id = 0;  // 存储状态请求下发的端口ID
    HMAC_SHA256_CTX hmac;
    RebootCmd_t reboot_cmd = {0};
    /* upgrade 解析临时变量 */
    uint32_t ota_new_len = 0U;
    uint32_t ota_new_crc32 = 0U;
    char    *ota_filename = NULL;

    LOG_NET("TCP Recv JSON:\r\n%s\r\n", buf);
    cJSON *root = cJSON_Parse(buf);
    if(!root) return;

    cJSON *type    = cJSON_GetObjectItem(root, "type");
    cJSON *device_id = cJSON_GetObjectItem(root, "device_id");
    cJSON *seq     = cJSON_GetObjectItem(root, "seq");
    cJSON *ts      = cJSON_GetObjectItem(root, "ts");
    cJSON *sign    = cJSON_GetObjectItem(root, "sign");

    if(!type || type->type != cJSON_String)            goto exit;
    if(!device_id || device_id->type != cJSON_String)  goto exit;
    if(!seq || seq->type != cJSON_Number)              goto exit;
    if(!ts || ts->type != cJSON_Number)                goto exit;
    if(!sign || sign->type != cJSON_String)            goto exit;

    if(strcmp(device_id->valuestring, g_device_id) != 0) 
    {
        LOG_NET("Device ID verification failed!\r\n");
        goto exit;
    }

    uint32_t curr_seq = (uint32_t)seq->valuedouble;
    uint64_t curr_ts  = (uint64_t)ts->valuedouble;

    uint64_t now_ts = Get_Unix_Second();
    int64_t time_diff = llabs((int64_t)now_ts - (int64_t)curr_ts);
    if(time_diff > TIME_VALID_SEC)  
    {
        LOG_NET("Time verification failed!\r\n");
        // goto exit;
    }

    if(curr_seq == g_last_cmd_seq)
    {
        LOG_NET("Sequence number verification failed!\r\n");
        // goto exit;
    }
    g_last_cmd_seq = curr_seq;

    char ts_cmd_str[21] = {0};
    uint64_to_str(curr_ts, ts_cmd_str);

    memset(g_task_order_buf, 0, sizeof(g_task_order_buf));
    g_task_order_cnt = 0;
    memset(tcp_sign_buf_2048, 0, sizeof(tcp_sign_buf_2048));

    if(strcmp(type->valuestring, "task_order") == 0)//任务指令
    {
        cJSON *task_info_arr = cJSON_GetObjectItem(root, "task_info");
        if(!task_info_arr ||  task_info_arr->type != cJSON_Array) goto exit;

        int arr_size = cJSON_GetArraySize(task_info_arr);

        for(int i = 0; i < arr_size && i < TASK_DATA_MAX; i++)
        {
            cJSON *item = cJSON_GetArrayItem(task_info_arr, i);
            if(!item) continue;

            // 严格按英文字典序获取字段
            cJSON *p_inj_id  = cJSON_GetObjectItem(item, "inj_id");
            cJSON *p_inj_ts  = cJSON_GetObjectItem(item, "inj_ts");
            cJSON *p_inj_v   = cJSON_GetObjectItem(item, "inj_v");
            cJSON *p_task_id = cJSON_GetObjectItem(item, "task_id");
            // 新增：分次任务字段（契约 §2.2，缺省按类型安全取 0/1）
            cJSON *p_task_type = cJSON_GetObjectItem(item, "task_type");
            cJSON *p_exec_at   = cJSON_GetObjectItem(item, "exec_at");
            cJSON *p_sub_index = cJSON_GetObjectItem(item, "sub_index");
            cJSON *p_sub_total = cJSON_GetObjectItem(item, "sub_total");
            cJSON *p_total_x10 = cJSON_GetObjectItem(item, "total_x10");
            cJSON *p_adj_period= cJSON_GetObjectItem(item, "adj_period_sec");

            // 字段必填合法性校验
            if(!p_task_id || !p_inj_id || !p_inj_v || !p_inj_ts)
            {
                continue;
            }

            TaskOrderInfo_t *p_buf = &g_task_order_buf[g_task_order_cnt];
            memset(p_buf,0,sizeof(TaskOrderInfo_t));
            strncpy(p_buf->task_id, p_task_id->valuestring, sizeof(p_buf->task_id) - 1);
            p_buf->inj_id     = (uint16_t)p_inj_id->valuedouble;
            p_buf->inj_ts     = (uint32_t)p_inj_ts->valuedouble;
            p_buf->inj_v      = (uint32_t)p_inj_v->valuedouble;
            p_buf->task_type  = (uint8_t)(p_task_type ? p_task_type->valuedouble : 1);
            p_buf->exec_at    = (uint32_t)(p_exec_at   ? p_exec_at->valuedouble   : 0);
            // sub_index/sub_total 数值钳制：非整数或越界（<1 / >65535）一律归 0（=非法值），
            // 由后续 type=3 契约校验统一拒绝并上报失败；避免 (uint16_t) 强转把越界值截断成"看起来合法"的数。
            {
                double d_sub_index = p_sub_index ? p_sub_index->valuedouble : 0;
                double d_sub_total = p_sub_total ? p_sub_total->valuedouble : 0;
                p_buf->sub_index = (uint16_t)((d_sub_index >= 1 && d_sub_index <= 65535) ? d_sub_index : 0);
                p_buf->sub_total = (uint16_t)((d_sub_total >= 1 && d_sub_total <= 65535) ? d_sub_total : 0);
            }
            p_buf->total_x10  = (uint32_t)(p_total_x10 ? p_total_x10->valuedouble : 0);
            p_buf->adj_period_sec = (uint32_t)(p_adj_period ? p_adj_period->valuedouble : 0);

            g_task_order_cnt++;
        }

        // 注：写入队列/调度表的动作已移至签名校验通过后（见函数末尾 task_order 分支），
        // 防止伪造 task_order 帧在未验签的情况下即触发注油。
        // 新建临时cJSON，按字典序构造签名原文
        temp_sign = cJSON_CreateObject();
        if(!temp_sign) goto exit;
        cJSON *arr_copy  = cJSON_Duplicate(task_info_arr, 1); // 深拷贝数组
        if(!arr_copy) goto exit;
        // 签名原文规范化为字典序（协议 §2.4.1）：使设备算出的签名串与网关算出的完全一致，
        // 不再依赖「报文里键的原始顺序」——网关调整字段顺序或按键排序下发时，设备仍能验签通过。
        // 规则：对象键按字节序排列（strcmp，区分大小写，与网关 Go 的 sort.Strings/json.Marshal 一致）；
        //       数组元素顺序保持不变（元素先后有语义，不能排序），仅递归元素内部的对象。
        json_sort_keys(arr_copy);
        // 字典序：device_id → seq → task_info → ts → type
        cJSON_AddStringToObject(temp_sign, "device_id", g_device_id);
        cJSON_AddNumberToObject(temp_sign, "seq", curr_seq);
        cJSON_AddItemToObject(temp_sign, "task_info", arr_copy);
        cJSON_AddNumberToObject(temp_sign, "ts", curr_ts);
        cJSON_AddStringToObject(temp_sign, "type", "task_order");

        // 导出签名字符串
        sign_src = cJSON_PrintUnformatted(temp_sign);
        if(sign_src)
        {
            //LOG_NET("TCP Sorted task_order JSON:\r\n%s\r\n", sign_src);
        }
    }
    else if(strcmp(type->valuestring, "state_request") == 0)//状态请求
    {
        cJSON *req_inj = cJSON_GetObjectItem(root, "inj_id");
        // 校验 inj_id 字段合法性
        if(!req_inj || req_inj->type != cJSON_Number)
        {
            LOG_NET("state_request inj_id invalid!\r\n");
            goto exit;
        }
        req_inj_id = (uint16_t)req_inj->valuedouble;

        // 字典序：device_id → inj_id → seq → ts → type
        snprintf(tcp_sign_buf_2048, sizeof(tcp_sign_buf_2048),
            "{\"device_id\":\"%s\",\"inj_id\":%u,\"seq\":%lu,\"ts\":%s,\"type\":\"state_request\"}",
            g_device_id,
            req_inj_id,
            (unsigned long)curr_seq,
            ts_cmd_str
        );
        //LOG_NET("TCP Sorted state_request JSON:\r\n%s\r\n", tcp_sign_buf_2048);
        sign_src = tcp_sign_buf_2048;
    }
    else if(strcmp(type->valuestring, "task_empty") == 0)//任务空闲通知
    {
        cJSON *msg = cJSON_GetObjectItem(root, "message");
        cJSON *wait = cJSON_GetObjectItem(root, "wait_time");
        if(!msg || msg->type != cJSON_String || !wait || wait->type != cJSON_Number)
        {
            goto exit;
        }
        // 字典序：device_id < message < seq < ts < type < wait_time
        snprintf(tcp_sign_buf_2048, sizeof(tcp_sign_buf_2048),
            "{\"device_id\":\"%s\",\"message\":\"%s\",\"seq\":%lu,\"ts\":%s,\"type\":\"task_empty\",\"wait_time\":%d}",
            g_device_id,
            msg->valuestring,
            (unsigned long)curr_seq,
            ts_cmd_str,
            (int)wait->valuedouble);

        //LOG_NET("TCP Sorted task_empty JSON:\r\n%s\r\n", tcp_sign_buf_2048);
        sign_src = tcp_sign_buf_2048;
    }
    else if(strcmp(type->valuestring, "stop_task") == 0)//停止任务
    {
        cJSON *task_id = cJSON_GetObjectItem(root, "task_id");
        if(!task_id || task_id->type != cJSON_String)
        {
            goto exit;
        }

        memset(g_stop_target_task_id, 0, sizeof(g_stop_target_task_id));
        strncpy(g_stop_target_task_id, task_id->valuestring, sizeof(g_stop_target_task_id)-1);
        g_stop_target_task_id[sizeof(g_stop_target_task_id)-1] = '\0';

        // 字典序：device_id → seq → task_id → ts → type
        snprintf(tcp_sign_buf_2048, sizeof(tcp_sign_buf_2048),
            "{\"device_id\":\"%s\",\"seq\":%lu,\"task_id\":\"%s\",\"ts\":%s,\"type\":\"stop_task\"}",
            g_device_id,
            (unsigned long)curr_seq,
            task_id->valuestring,
            ts_cmd_str);
        //LOG_NET("TCP Sorted stop_task JSON:\r\n%s\r\n", tcp_sign_buf_2048);
        sign_src = tcp_sign_buf_2048;
    }
    else if(strcmp(type->valuestring, "heartbeat_ack") == 0)//心跳确认
    {
        // 提取新增字段并做合法性校验
        cJSON *server_time = cJSON_GetObjectItem(root, "server_time");
        cJSON *has_task    = cJSON_GetObjectItem(root, "has_pending_task");
        if(!server_time || server_time->type != cJSON_Number || !has_task || (has_task->type != cJSON_True && has_task->type != cJSON_False))
        {
            goto exit;
        }

        // 此处读取服务端时间、待任务标记，存入全局变量
        uint64_t server_ts = (uint64_t)server_time->valuedouble;
        bool pending_task  = (has_task->type == cJSON_True) ? true : false;
        // 分别转换 ts、server_time 为字符串
        char server_ts_str[21] = {0};
        uint64_to_str_2(server_ts, server_ts_str, sizeof(server_ts_str));
        LOG_NET("Server time: %s, Has pending task: %d\r\n", server_ts_str, pending_task);
        
        // 严格按英文字典序拼接签名字符串（剔除 sign 字段）
        // 字段顺序：device_id → has_pending_task → seq → server_time → ts → type
        snprintf(tcp_sign_buf_2048, sizeof(tcp_sign_buf_2048),
            "{\"device_id\":\"%s\",\"has_pending_task\":%s,\"seq\":%lu,\"server_time\":%s,\"ts\":%s,\"type\":\"heartbeat_ack\"}",
            g_device_id,
            has_task->type == cJSON_True ? "true" : "false",
            (unsigned long)curr_seq,
            server_ts_str,
            ts_cmd_str);

        //LOG_NET("TCP Sorted heartbeat_ack JSON:\r\n%s\r\n", tcp_sign_buf_2048);
        sign_src = tcp_sign_buf_2048;
    }
    else if(strcmp(type->valuestring, "device_reboot") == 0)//设备重启
    {
        cJSON *delay_obj = cJSON_GetObjectItem(root, "delay");
        cJSON *reason_obj = cJSON_GetObjectItem(root, "reason");

        // 解析可选字段，缺省用默认值
        if(delay_obj && delay_obj->type == cJSON_Number)
        {
            reboot_cmd.delay_sec = (uint32_t)delay_obj->valuedouble;
        }
        if(reason_obj && reason_obj->type == cJSON_String)
        {
            strncpy(reboot_cmd.reason, reason_obj->valuestring, sizeof(reboot_cmd.reason)-1);
            reboot_cmd.reason[sizeof(reboot_cmd.reason)-1] = '\0';
        }

        // 按字典序构造签名原文：delay → device_id → reason → seq → ts → type
        temp_sign = cJSON_CreateObject();
        if(!temp_sign) goto exit;

        if(delay_obj && delay_obj->type == cJSON_Number)
        {
            cJSON_AddNumberToObject(temp_sign, "delay", reboot_cmd.delay_sec);
        }
        cJSON_AddStringToObject(temp_sign, "device_id", g_device_id);
        if(reason_obj && reason_obj->type == cJSON_String)
        {
            cJSON_AddStringToObject(temp_sign, "reason", reboot_cmd.reason);
        }
        cJSON_AddNumberToObject(temp_sign, "seq", curr_seq);
        cJSON_AddNumberToObject(temp_sign, "ts", curr_ts);
        cJSON_AddStringToObject(temp_sign, "type", "device_reboot");

        sign_src = cJSON_PrintUnformatted(temp_sign);
        if(sign_src == NULL)
        {
            goto exit;
        }
    }
    else if(strcmp(type->valuestring, "upgrade") == 0)//升级指令
    {
        cJSON *obj_crc       = cJSON_GetObjectItem(root, "crc");
        cJSON *obj_filename  = cJSON_GetObjectItem(root, "filename");
        cJSON *obj_file_size = cJSON_GetObjectItem(root, "file_size");

        if(!obj_crc       || obj_crc->type != cJSON_String ||
           !obj_filename  || obj_filename->type != cJSON_String ||
           !obj_file_size || obj_file_size->type != cJSON_Number)
        {
            LOG_NET("upgrade param invalid\r\n");
            goto exit;
        }

        /* crc 解析为 uint32（8 位 HEX 字符串，大小写均可） */
        ota_new_crc32   = (uint32_t)strtoul(obj_crc->valuestring, NULL, 16);
        ota_new_len     = (uint32_t)obj_file_size->valuedouble;
        ota_filename    = obj_filename->valuestring;

        /* HMAC 签名源串：与网关 build_sign_src 严格对齐（crc 直接用原始字符串） */
        snprintf(tcp_sign_buf_2048, sizeof(tcp_sign_buf_2048),
            "{\"crc\":\"%s\",\"device_id\":\"%s\",\"file_size\":%lu,\"filename\":\"%s\",\"seq\":%lu,\"ts\":%s,\"type\":\"upgrade\"}",
            obj_crc->valuestring,
            g_device_id,
            (unsigned long)ota_new_len,
            ota_filename,
            (unsigned long)curr_seq,
            ts_cmd_str);

        sign_src = tcp_sign_buf_2048;
    }
    else
    {
        goto exit;
    }

    if(sign_src == NULL || strlen(sign_src) == 0)
    {
        goto exit;
    }
    uint8_t calc_hash[32] = {0};
    char calc_sign[9] = {0};
    hmac_sha256_init(&hmac, (const uint8_t *)HMAC_KEY, strlen(HMAC_KEY));
    hmac_sha256_update(&hmac, (const uint8_t *)sign_src, strlen(sign_src));
    hmac_sha256_final(&hmac, calc_hash);
    snprintf(calc_sign, sizeof(calc_sign), "%02X%02X%02X%02X",
            calc_hash[0], calc_hash[1], calc_hash[2], calc_hash[3]);

    //LOG_NET("Calc TCP sign: %s\r\n", calc_sign);         
    if(strcmp(sign->valuestring, calc_sign) != 0)
    {
        LOG_NET("sign check failed!\r\nExpected: %s, Actual: %s\r\n", calc_sign, sign->valuestring);
        goto exit;
    }
    LOG_NET("TCP received message successfully!\r\n");

    //收到上位机任意合法报文，清零心跳丢失计数
    hb_lost_cnt = 0;

    // 判断当前指令类型，state_request 在此处回复应答
    if(strcmp(type->valuestring, "state_request") == 0)
    {
        if(req_inj_id == 0)
        {
            // 请求ID=0：上传全部INJECTOR_CNT个端口
            tcp_send_all_state_response();
        }
        else if(req_inj_id >= 1 && req_inj_id <= INJECTOR_CNT)
        {
            // 上位机ID 1~8 → 数组下标 = ID - 1
            uint16_t port_idx = req_inj_id - 1;
            StateRespParam_t resp_param;
            //填充指定端口数据
            FillStateRespData(&resp_param, port_idx);
            //发送状态响应报文
            tcp_send_state_response(&resp_param);
        }
        else
        {
            LOG_NET("state_request inj_id out of range 1~%d\r\n", INJECTOR_CNT);
        }
    }
    if(strcmp(type->valuestring, "stop_task") == 0)
    {
        // 全局g_task_id非空，且下发task_id和当前运行任务一致
        if(strlen(g_tcp_task_bind.task_id) != 0 && strcmp(g_tcp_task_bind.task_id, g_stop_target_task_id) == 0)
        {
            g_force_stop_task = 1;
            LOG_NET("Valid stop_task cmd matched task_id:%s, trigger emergency stop\r\n", g_stop_target_task_id);
        }
        else
        {
            LOG_NET("stop_task task_id mismatch, current tcp task:%s, req stop:%s\r\n", g_tcp_task_bind.task_id, g_stop_target_task_id);
        }
    }
    if(strcmp(type->valuestring, "device_reboot") == 0)
    {
        // 指令入队，交给重启任务处理
        if(xQueueSend(xRebootCmdQueue, &reboot_cmd, 0) != pdPASS)
        {
            LOG_NET("Reboot cmd queue full, drop command\r\n");
        }
    }
    if(strcmp(type->valuestring, "upgrade") == 0)
    {
        int ota_ret = ota_handle_upgrade_start(ota_new_len, ota_new_crc32,
                                               ota_filename);
        uint8_t ack_status = (ota_ret == 0) ? 0U : (uint8_t)(-ota_ret);
        const char *ack_msg = (ota_ret == 0) ? "upgrade_accepted" : "upgrade_rejected";
        tcp_send_upgrade_ack(ack_status, ack_msg, (ota_ret == 0) ? 60U : 0U);
    }

    // ---- 签名校验已通过：task_order 才实际入队 / 进调度表 ----
    // 关键安全顺序：必须先验签再触发注油动作，否则伪造帧会在验签失败前已排进队列。
    if(strcmp(type->valuestring, "task_order") == 0)
    {
        for(int i = 0; i < g_task_order_cnt; i++)
        {
            TaskOrderInfo_t *p = &g_task_order_buf[i];

            // ---- type=3 分次任务：契约前提校验（必须先于去重检查） ----
            // 复合去重键 (task_id, sub_index) 的正确性依赖"同一轮内 sub_index 唯一且有效"。
            // 网关若漏带 sub_index（缺省 0），同轮第 2..K 批的键会与首批完全相同 → 被 dedup 误杀 → 整轮只注 1/K（漏注）；
            // 若与 type=1/2/4 同 task_id 还会互相误杀。
            // 故显式校验：task_type=3 时必须 1 <= sub_index <= sub_total，否则【拒绝该批并上报失败】
            //   （宁可在契约违规时显式报错，也不 silently 漏注）。
            // 位置必须在 dedup_is_duplicate【前】：若放在之后，非法批会被上一批的键误判为"重传"而静默跳过，
            //   错被掩盖、网关收不到失败上报。
            if(p->task_type == 3 && (p->sub_index < 1 || p->sub_index > p->sub_total))
            {
                LOG_NET("split task invalid sub_index, reject: task_id=%s sub_index=%u sub_total=%u\r\n",
                        p->task_id, p->sub_index, p->sub_total);
                tcp_report_fail(p->task_id, p->inj_id, 8, "Invalid split task sub_index !");
                continue;
            }

            // 去重：同一子任务（task_id + sub_index）重传则跳过，防止重复注油（§4.2-6 / §6.2）
            if(dedup_is_duplicate(p->task_id, p->sub_index))
            {
                LOG_NET("task_order dedup skip: task_id=%s sub_index=%u\r\n", p->task_id, p->sub_index);
                continue;
            }
            // 注：去重键一律在【本任务成功被受理之后】才落（type=3 = 入表成功，见下方 type3 分支的 else；
            //   type=1/2/4 = 入队成功，见下方 else 分支）：若先落键而受理失败（表满/队列满），该任务会被
            //   去重环记住、网关重传被 dedup_is_duplicate 拦下 → 永久丢失（且网关收不到失败上报）。
            // 去重键 = (task_id, sub_index)：type=1/2/4 不携带 sub_index（契约 §2.2，仅 type=3 携带），
            //   故其键退化为单 task_id —— 一轮只有一个实体任务，单键正是应有的粒度。

            if(p->task_type == 3)
            {
                // 捕获离线轮次计划：在线收到分次批即记录【本注油点】的轮次配置，供离线期按 adj_period_sec 自行整批注油（§6.9）。
                // 2026-10-30 由单实例改为按 inj_id-1 分槽（每点一份）：原实现只有一份全局配置，8 个注油点各自下发
                //   分次批时会因 task_id 变化互相整份覆盖，最终只剩最后一个点保有离线自注油能力，其余 7 点离线期完全不注油。
                // 现轮界以【本槽自己的 task_id】判定：同槽 task_id 变化 = 该点的新一轮；不同槽互不影响。
                //   故同时兼容"一个 task_id 跨多点下发"与"每点独立 task_id"两种网关风格。
                if(p->inj_id >= 1 && p->inj_id <= INJECTOR_CNT)
                {
                    OfflineRoundSched_t *r = &g_offline_round_sched[p->inj_id - 1];
                    // 本槽首次见到该 task_id = 该点新一轮起点，记录轮起始参考时刻
                    uint8_t new_round = (r->valid == 0) ||
                                        (strncmp(r->task_id, p->task_id, TASK_ID_LEN - 1) != 0);
                    if(new_round)
                    {
                        r->valid          = 1;
                        r->inj_id         = p->inj_id;
                        r->total_x10      = p->total_x10;
                        r->adj_period_sec = p->adj_period_sec;
                        strncpy(r->task_id, p->task_id, TASK_ID_LEN - 1);
                        r->task_id[TASK_ID_LEN - 1] = '\0';
                        r->last_fire_unix = (p->exec_at > 0) ? (uint32_t)p->exec_at
                                                            : (uint32_t)Get_Unix_Second();
                    }
                    else
                    {
                        // 同轮后续批：刷新配置（total_x10/adj_period_sec 可能更新），不重置轮起点；
                        // 迟到的首批量(sub_index==1)用其 exec_at 校正轮起点
                        r->total_x10      = p->total_x10;
                        r->adj_period_sec = p->adj_period_sec;
                        if(p->sub_index == 1 && p->exec_at > 0)
                            r->last_fire_unix = (uint32_t)p->exec_at;
                    }
                }
                else
                {
                    LOG_NET("split task invalid inj_id, skip offline round capture: inj_id=%u task_id=%s\r\n",
                            p->inj_id, p->task_id);
                }

                // 分次任务：进调度表，由 task_scheduler_task 在 exec_at 到点触发；不立即执行、不改周期配置
                // 入表失败（表满）必须像 type1/2/4 槽满那样上报失败，让网关知道该批未排上程、可重试；
                //   否则网关只看到"没回包"，会一直等到看门狗超时才处理（契约 §4.2-7）。
                //   注意：此处尚未 dedup_mark（见下方 else 分支），故网关重传时该批仍可重新入表（若此时有空位）。
                if(sched_add_split_task(p) != 0)
                {
                    LOG_NET("sched_list full, drop split task: task_id=%s sub_index=%u\r\n", p->task_id, p->sub_index);
                    tcp_report_fail(p->task_id, p->inj_id, 9, "The task list is full !");
                }
                else
                {
                    // 入表成功后才落去重键：若先落键而入表失败，该批会被去重环记住、
                    //   网关重传将被 dedup_is_duplicate 拦下 → 该批永久丢失（且网关收不到失败上报）。
                    dedup_mark(p->task_id, p->sub_index);
                    LOG_NET("split task scheduled: task_id=%s inj_id=%u inj_v=%lu exec_at=%lu sub=%u/%u\r\n",
                        p->task_id, p->inj_id, (unsigned long)p->inj_v, (unsigned long)p->exec_at, p->sub_index, p->sub_total);
                }
            }
            else
            {
                // task_type 1/2/4：保持旧逻辑，立即入队由 TCP_task_processing_task 处理（含周期配置更新）
                // 注：分次字段（task_type/exec_at/sub_index/...）属下行 task_order 语义，由 TaskOrderInfo_t 承载，
                //     此处不再向 TaskInfo_t 冗余搬运（TaskInfo_t 侧零读取）。
                TaskInfo_t item;
                memset(&item, 0, sizeof(TaskInfo_t)); // 先清空，防止脏数据
                item.inj_id = p->inj_id;
                item.inj_ts = p->inj_ts;
                item.inj_v  = p->inj_v;
                //拷贝task_id，截断保护
                strncpy(item.task_id, p->task_id, TASK_ID_LEN - 1);
                item.task_id[TASK_ID_LEN - 1] = '\0';
                // 入队，超时10ms
                if(xQueueSend(xTcpTaskQueue, &item, pdMS_TO_TICKS(10)) == pdPASS)
                {
                    // 入队【成功之后】才落去重键（与 type=3 的"入表成功后落键"同一原则）：
                    //   若先落键而入队失败（队列满），该任务会被去重环记住 → 网关重传被 dedup_is_duplicate
                    //   拦下 → 任务永久丢失，且网关收不到任何失败上报。
                    // 去重键用 p->sub_index（type=1/2/4 恒为 0，等价于单 task_id 键）：
                    //   必须与上方 dedup_is_duplicate 的检查键完全一致，否则检查查 (task_id,5) 而落键写
                    //   (task_id,0) 会导致去重失效、并污染 type=1/2/4 的键空间。
                    // 语义：同一 task_id 的重传帧被拦下 → 防止重复注油（契约 §4.2-6）。
                    dedup_mark(p->task_id, p->sub_index);
                    LOG_NET("tcp task queued: task_id=%s inj_id=%u inj_v=%lu inj_ts=%lu\r\n",
                        p->task_id, p->inj_id, (unsigned long)p->inj_v, (unsigned long)p->inj_ts);
                }
                else
                {
                    // 队列满：入队失败，不落去重键 → 网关重传仍可重新入队（不因一次拥塞永久丢任务）。
                    LOG_NET("tcp task queue full, drop task: task_id=%s inj_id=%u\r\n",
                        p->task_id, p->inj_id);
                }
            }
        }
    }

exit:
    if(temp_sign != NULL)
    {
        cJSON_Delete(temp_sign);
    }
    if(sign_src != tcp_sign_buf_2048 && sign_src != NULL)
    {
        cJSON_PortFree(sign_src);
    }
    cJSON_Delete(root);
}


/**
 * @brief TCP 连上后发送 register 注册报文（seq 复位为 1）
 */
static void tcp_send_register(void)
{
    if(tcp_pcb == NULL || g_tcp_connected !=1)
    {
        return;
    }
    cJSON *root = cJSON_CreateObject();
    uint64_t ts = Get_Unix_Second();
    char mac_str[32] = {0};
    uint8_t *mac = gnetif.hwaddr;

    snprintf(mac_str, sizeof(mac_str), "%02X:%02X:%02X:%02X:%02X:%02X",
             mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);

    memset(sign_buf_register, 0, sizeof(sign_buf_register));
    char ts_online_str[21] = {0};
    uint64_to_str(ts, ts_online_str);
    g_tcp_seq=1; //注册报文seq固定为1，后续正常递增
    snprintf(sign_buf_register, sizeof(sign_buf_register) - 1,
        "{\"device_id\":\"%s\",\"firmware_ver\":\"%s\",\"mac\":\"%s\",\"model\":\"%s\",\"seq\":%lu,\"ts\":%s,\"type\":\"register\"}",
        g_device_id,
        DEVICE_FW_VER,
        mac_str,
        DEVICE_MODEL,
        (unsigned long)g_tcp_seq,
        ts_online_str);
    //LOG_NET("TCP Sorted register JSON:\r\n%s\r\n", sign_buf_register);

    uint8_t hash[32] = {0};
    HMAC_SHA256_CTX hmac_local;
    hmac_sha256_init(&hmac_local, (const uint8_t *)HMAC_KEY, strlen(HMAC_KEY));
    hmac_sha256_update(&hmac_local, (const uint8_t *)sign_buf_register, strlen(sign_buf_register));
    hmac_sha256_final(&hmac_local, hash);

    char sign_str[9] = {0};
    snprintf(sign_str, sizeof(sign_str), "%02X%02X%02X%02X",
             hash[0], hash[1], hash[2], hash[3]);

    cJSON_AddStringToObject(root, "type", "register");
    cJSON_AddStringToObject(root, "device_id", g_device_id);
    cJSON_AddStringToObject(root, "mac", mac_str);
    cJSON_AddStringToObject(root, "model", DEVICE_MODEL);
    cJSON_AddStringToObject(root, "firmware_ver", DEVICE_FW_VER);
    cJSON_AddNumberToObject(root, "ts", ts);
    cJSON_AddNumberToObject(root, "seq", g_tcp_seq);
    cJSON_AddStringToObject(root, "sign", sign_str);

    char *str = cJSON_PrintUnformatted(root);
    if(str)
    {
        // 使用队列投递，不再直接调用 tcp_send_str
        tcp_send_msg_t msg;
        msg.data = (char *)pvPortMalloc(strlen(str) + 1);
        if(msg.data) {
            strcpy(msg.data, str);
            if(xQueueSend(tcp_send_queue, &msg, 0) != pdPASS) {
                vPortFree(msg.data);          // 队列满，丢弃
                LOG_NET("TCP send queue full, drop register");
            }
        }
        cJSON_PortFree(str);
        g_tcp_seq++;
    }
    cJSON_Delete(root);
}


/**
 * @brief 批量组包并上报 execute_result 执行结果
 * @param info_arr 执行结果数组
 * @param arr_len 数组元素个数
 */
void tcp_send_execute_result(ExecuteResultInfo_t *info_arr, uint16_t arr_len)
{
    if(tcp_pcb == NULL || g_tcp_connected != 1)
    {
        return;
    }
    if(info_arr == NULL || arr_len == 0)
    {
        LOG_NET("execute result array is empty!\r\n");
        return;
    }

    cJSON *root = cJSON_CreateObject();
    cJSON *task_info_arr = cJSON_CreateArray();
    uint64_t ts = Get_Unix_Second();

    // 填充数组子项，内部字段严格字典序
    for (uint16_t i = 0; i < arr_len; i++)
    {
        cJSON *item = cJSON_CreateObject();
        
        cJSON_AddNumberToObject(item, "actual_volume",   info_arr[i].actual_volume);
        // 失败时追加错误字段，字典序保持正确
        if(info_arr[i].execute_result == 3)
        {
            cJSON_AddNumberToObject(item, "error_code", info_arr[i].error_code);
            cJSON_AddStringToObject(item, "error_msg", info_arr[i].error_msg);
        }
        cJSON_AddNumberToObject(item, "execute_result", info_arr[i].execute_result);
        cJSON_AddNumberToObject(item, "inj_id",          info_arr[i].inj_id);
        // 分次回报：仅在线分次（type3 且 sub_total>0）原样回显 task_order 下发的 sub_index/sub_total
        if(info_arr[i].sub_total > 0)
        {
            cJSON_AddNumberToObject(item, "sub_index",   info_arr[i].sub_index);
            cJSON_AddNumberToObject(item, "sub_total",   info_arr[i].sub_total);
        }
        cJSON_AddStringToObject(item, "task_id",         info_arr[i].task_id);
        cJSON_AddNumberToObject(item, "valve_act_tm",    info_arr[i].valve_act_tm);
        cJSON_AddNumberToObject(item, "valve_hum",       info_arr[i].valve_hum);
        cJSON_AddNumberToObject(item, "valve_temp",      info_arr[i].valve_temp);
        cJSON_AddNumberToObject(item, "valve_total_tm",  info_arr[i].valve_total_tm);

        cJSON_AddItemToArray(task_info_arr, item);
    }

    // 顶层根节点 严格字典序，不含sign
    cJSON_AddStringToObject(root, "device_id", g_device_id);
    cJSON_AddNumberToObject(root, "seq", g_tcp_seq);
    cJSON_AddItemToObject(root, "task_info", task_info_arr);
    cJSON_AddNumberToObject(root, "ts", ts);
    cJSON_AddStringToObject(root, "type", "execute_result");

    // 生成无签名字符串，计算HMAC
    char *json_no_sign = cJSON_PrintUnformatted(root);
    if (json_no_sign == NULL)
    {
        cJSON_Delete(root);
        return;
    }

    // HMAC-SHA256 计算签名（hmac改为局部变量，避免并发踩踏）
    uint8_t hash[32] = {0};
    HMAC_SHA256_CTX hmac_local;
    hmac_sha256_init(&hmac_local, (const uint8_t *)HMAC_KEY, strlen(HMAC_KEY));
    hmac_sha256_update(&hmac_local, (const uint8_t *)json_no_sign, strlen(json_no_sign));
    hmac_sha256_final(&hmac_local, hash);

    char sign_str[9] = {0};
    snprintf(sign_str, sizeof(sign_str), "%02X%02X%02X%02X",
             hash[0], hash[1], hash[2], hash[3]);

    // 末尾追加sign字段
    cJSON_AddStringToObject(root, "sign", sign_str);

    // 发送报文
    char *str = cJSON_PrintUnformatted(root);
    if(str) 
    {
        // 使用队列投递，不再直接调用 tcp_send_str
        tcp_send_msg_t msg;
        msg.data = (char *)pvPortMalloc(strlen(str) + 1);
        if(msg.data) {
            strcpy(msg.data, str);
            if(xQueueSend(tcp_send_queue, &msg, 0) != pdPASS) {
                vPortFree(msg.data);          // 队列满，丢弃
                LOG_NET("TCP send queue full, drop execute_result");
            }
        }
        cJSON_PortFree(str);   // 释放 cJSON 生成的原始字符串
        g_tcp_seq++;
    }

    cJSON_PortFree(json_no_sign);
    cJSON_Delete(root);
}


