 * 按本工程约定不实现空闲超时退出，一律长按返回（与原 System Settings 一致）。
 * 编辑对象为 main_config（Modbus 保持寄存器可见），保存走既有的
 * sync_to_sysdb() / sync_to_modbus()，不改 Modbus 侧与以太网侧代码。
 * 注意：以太网实际 IP 由 g_net_cfg（FlashDB KV "net_cfg" / UDP 配网）决定；
 *       这里的 IP/掩码/网关/服务器地址是 main_config 中的配置副本，
 *       菜单不会改写 lwIP 地址；串口波特率/从站地址需重启后生效。
 * ========================================================================== */

#define IP_STR_LEN   16U   // main_config 中 IP 类字段均为 char[16]
#define BAUD_SEL_CNT 6U

static const uint32_t s_baud_table[BAUD_SEL_CNT] = {
    9600UL, 19200UL, 38400UL, 57600UL, 115200UL, 230400UL
};

/**
 * @brief 保存通讯参数到 FlashDB 并刷新 Modbus 保持寄存器
 */
static void comm_save_main_config(void)
{
    sync_to_sysdb();
    sync_to_modbus();   // 防止 sync_from_modbus() 用旧寄存器值回写覆盖新配置
}

static void save_slave_id(uint32_t v)
{
    main_config.slaveID = (uint16_t)v;
    comm_save_main_config();
}

static void save_baudrate(uint32_t v)
{
    main_config.BaudRate = v;
    comm_save_main_config();
}

static void save_server_port(uint32_t v)
{
    main_config.serverPort = (uint16_t)v;
    comm_save_main_config();
}

/**
 * @brief 解析 "a.b.c.d" 为 4 段；非法/空串按 0.0.0.0 处理
 * @param s 源字符串
 * @param out 输出 4 段
 */
static void parse_ipv4(const char *s, uint8_t out[4])
{
    for (uint8_t i = 0; i < 4U; i++)
    {
        uint32_t v = 0;
        while ((*s >= '0') && (*s <= '9'))
        {
            v = v * 10U + (uint32_t)(*s - '0');
            s++;
        }
        out[i] = (uint8_t)((v > 255U) ? 255U : v);
        if (*s == '.')
        {
            s++;
        }
    }
}

