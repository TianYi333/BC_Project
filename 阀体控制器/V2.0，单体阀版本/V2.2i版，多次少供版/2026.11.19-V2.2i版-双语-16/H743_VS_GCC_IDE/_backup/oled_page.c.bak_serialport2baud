/**
 * @brief 通用二级菜单事件分发（参考 Oil_Pump_Control）
 * @param menu 菜单实例
 * @param event 上下/确认/返回事件
 * @param exit_flag 退出标记，置 0 表示退出该级菜单
 */
static void sub_menu_handle_event(Menu *menu, MenuEventType event, uint8_t *exit_flag)
{
    switch (event)
    {
    case MENU_EVENT_UP:
        if (menu->cur_index > 0U)
        {
            menu->cur_index--;
            if (menu->cur_index < menu->top_index) menu->top_index--;
        }
        break;
    case MENU_EVENT_DOWN:
        if (menu->cur_index < menu->item_total - 1U)
        {
            menu->cur_index++;
            if (menu->cur_index >= menu->top_index + MENU_VISIBLE_MAX) menu->top_index++;
        }
        break;
    case MENU_EVENT_ENTER:
        if (menu->items[menu->cur_index].callback != NULL)
        {
            menu->items[menu->cur_index].callback();
        }
        else
        {
            *exit_flag = 0U;   // Back 项
        }
        break;
    case MENU_EVENT_BACK:
        *exit_flag = 0U;
        break;
    default:
        break;
    }
}

