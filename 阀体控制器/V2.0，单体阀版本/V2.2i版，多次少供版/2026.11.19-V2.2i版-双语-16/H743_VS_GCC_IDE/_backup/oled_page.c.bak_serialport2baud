/**
 * @brief 编辑页事件轮询（100ms 节拍，仅驱动重绘；无空闲超时）
 * @param st 输出编码器事件
 * @retval 1=收到按键 0=无事件
 */
static uint8_t edit_poll(EncoderState *st)
{
    if (xQueueReceive(QUEUE_KEY, st, pdMS_TO_TICKS(100)) == pdPASS)
    {
        return 1U;
    }
    return 0U;
}

/**
 * @brief 通用数值编辑页：旋转调值，短按保存，长按返回
 * @param title 页面标题
 * @param prefix 数值前缀
 * @param cur 初值
 * @param min 最小值
 * @param max 最大值
 * @param step 步长
 * @param saver 保存回调
 */
static void edit_number_page(const char *title, const char *prefix,
                             uint32_t cur, uint32_t min, uint32_t max,
                             uint32_t step, void (*saver)(uint32_t))
{
    uint32_t val = cur;
    char val_buf[40];
    const char *note = "Modbus/DB config - reboot to apply";
    const char *status = "Rotate +/- | Press Save | Long Back";
    EncoderState st;
    uint8_t run = 1U;

    while (run)
    {
        snprintf(val_buf, sizeof(val_buf), "%s: %lu", prefix, (unsigned long)val);
        draw_edit_page(title, val_buf, note, status);
        if (edit_poll(&st) == 0U)
        {
            continue;
        }
        switch (st)
        {
        case ENCODER_CW:
            val = ((val + step) <= max) ? (val + step) : max;
            break;
        case ENCODER_CCW:
            val = (val >= (min + step)) ? (val - step) : min;
            break;
        case ENCODER_PUTH:
            saver(val);
            show_oled_msg(OLED_MSG_UPDATE, "Saved");
            break;
        case ENCODER_PUTH_LONG:
            run = 0U;
            break;
        default:
            break;
        }
    }
}

/**
 * @brief 波特率编辑页：6 档枚举，短按保存，长按返回
 */
static void edit_baud_page(void)
{
    uint8_t sel = 0U;
    char val_buf[40];
    const char *note = "Modbus/DB config - reboot to apply";
    const char *status = "Rotate +/- | Press Save | Long Back";
    EncoderState st;
    uint8_t run = 1U;

    for (uint8_t i = 0U; i < BAUD_SEL_CNT; i++)
    {
        if (s_baud_table[i] == main_config.BaudRate)
        {
            sel = i;
            break;
        }
    }

    while (run)
    {
        snprintf(val_buf, sizeof(val_buf), "Rate: %lu", (unsigned long)s_baud_table[sel]);
        draw_edit_page("UART Baudrate", val_buf, note, status);
        if (edit_poll(&st) == 0U)
        {
            continue;
        }
        switch (st)
        {
        case ENCODER_CW:
            if (sel < BAUD_SEL_CNT - 1U) sel++;
            break;
        case ENCODER_CCW:
            if (sel > 0U) sel--;
            break;
        case ENCODER_PUTH:
            save_baudrate(s_baud_table[sel]);
            show_oled_msg(OLED_MSG_UPDATE, "Saved");
            break;
        case ENCODER_PUTH_LONG:
            run = 0U;
            break;
        default:
            break;
        }
    }
}

/**
 * @brief 写回 IPv4 配置字符串并保存到 FlashDB
 * @param dst main_config 中的 char[16] 配置字符串
 * @param seg 4 段地址值
 */
static void save_ipv4_field(char *dst, const uint8_t seg[4])
{
    snprintf(dst, IP_STR_LEN, "%u.%u.%u.%u",
             (unsigned)seg[0], (unsigned)seg[1], (unsigned)seg[2], (unsigned)seg[3]);
    comm_save_main_config();
    show_oled_msg(OLED_MSG_UPDATE, "Saved");
}

/**
 * @brief IPv4 编辑页：旋转调当前段，短按保存并切段，长按保存并返回
 * @param title 页面标题
 * @param dst main_config 中的 char[16] 配置字符串
 */
static void edit_ipv4_page(const char *title, char *dst)
{
    uint8_t seg[4];
    uint8_t idx = 0U;
    char val_buf[40];
    char note[48];
    const char *status = "Rotate +/- | Press Save/Next | Long Back";
    EncoderState st;
    uint8_t run = 1U;
    uint8_t dirty = 0U;

    parse_ipv4(dst, seg);
    while (run)
    {
        snprintf(val_buf, sizeof(val_buf), "%u.%u.%u.%u",
                 (unsigned)seg[0], (unsigned)seg[1], (unsigned)seg[2], (unsigned)seg[3]);
        snprintf(note, sizeof(note), "Edit segment %u / 4 (DB cfg, not lwIP)", (unsigned)(idx + 1U));
        draw_edit_page(title, val_buf, note, status);
        if (edit_poll(&st) == 0U)
        {
            continue;
        }
        switch (st)
        {
        case ENCODER_CW:
            if (seg[idx] < 255U)
            {
                seg[idx]++;
                dirty = 1U;
            }
            break;
        case ENCODER_CCW:
            if (seg[idx] > 0U)
            {
                seg[idx]--;
                dirty = 1U;
            }
            break;
        case ENCODER_PUTH:
            // 有改动才写 FlashDB，然后切到下一段
            if (dirty)
            {
                save_ipv4_field(dst, seg);
                dirty = 0U;
            }
            idx = (uint8_t)((idx + 1U) % 4U);
            break;
        case ENCODER_PUTH_LONG:
            // 返回前补一次保存，避免直接长按退出丢失改动
            if (dirty)
            {
                save_ipv4_field(dst, seg);
            }
            run = 0U;
            break;
        default:
            break;
        }
    }
}

