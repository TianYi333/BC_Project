 * @brief Serial Port 入口：直接进入串口波特率编辑页（无二级菜单列表）
 */
void serial_port_settings_callback(void)
{
    edit_baud_page();
}

/* ============================================================================
 * P/Q 模型速度设置（ZDT 电机转速）
 * 两层交互（参考 Oil_Pump_Control 的 PID P/I/D 三合一设置页）：
 *   1) 选择态（默认）：旋转在"最大速度 / 目标速度"两项之间移动光标（光标行前缀 '>'），
 *      短按进入该项的修改态；
 *   2) 修改态：光标行前缀由 '>' 变为 '*'，旋转调值（步进 50，下限 200，
 *      最大速度项上限 3000、目标速度项上限为最大速度），
 *      短按确认并退回选择态；
 *   3) 长按：直接返回上一级，不保存（保存仅在修改态短按确认时进行）。
 *
 * 存储：复用 injector_config 的两个既有字段（Modbus 侧结构体，不新增字段）：
 *   - maxMotorSpeed  = 最大速度（上限）
 *   - baseMotorSpeed = 目标速度（实际使用值）
 * 两个页面（P/Q Model Speed）共用同一个编辑器，最终存的是同一份值。
 * 保存走 sync_to_sysdb()（落 FlashDB，掉电保留）+ sync_to_modbus()
 * （刷新保持寄存器 209/210 与 211/212，使上位机可读到新值）。
 *
 * 注意：当前阶段"不同步到电机下发 buffer" —— motor_zdt.c 中 0xFB/0xFD
 * 位置命令的速度字段仍是硬编码 0x08FF，本页设定值暂不改变实际下发内容；
 * 待后续把该字段改为读取本值后才真正生效。
 * 无空闲超时返回。
 * ========================================================================== */

#define MOTOR_SPEED_MIN_RPM   200U
#define MOTOR_SPEED_MAX_RPM   3000U
#define MOTOR_SPEED_STEP_RPM  50U

// 速度设置页的两个可选项
#define MOTOR_SPEED_ITEM_MAX   0U   // 最大速度
#define MOTOR_SPEED_ITEM_BASE  1U   // 目标速度
#define MOTOR_SPEED_ITEM_CNT   2U

/**
 * @brief 速度设置页绘制：两行文本，光标项用前缀标记
 *        选择态（上下移动光标）用 '>'，进入修改后该行变为 '*'
 * @param title 页面标题
 * @param max_val 最大速度值
 * @param base_val 目标速度值
 * @param sel 当前选中项（MOTOR_SPEED_ITEM_MAX / _BASE）
 * @param editing 0=选择态（光标 '>'） 1=修改态（当前项 '*'）
 * @param status 底部操作提示
 */
static void draw_motor_speed_page(const char *title, uint16_t max_val,
                                  uint16_t base_val, uint8_t sel,
                                  uint8_t editing, const char *status)
{
    char buf[40];
    const char *labels[MOTOR_SPEED_ITEM_CNT];
    uint16_t vals[MOTOR_SPEED_ITEM_CNT];

    labels[0] = "最大速度";
    labels[1] = "目标速度";
    vals[0] = max_val;
    vals[1] = base_val;

    u8g2_FirstPage(&g_u8g2);
    do
    {
        // 标题栏（与本工程其他页面一致：白底黑字）
        u8g2_DrawBox(&g_u8g2, 0, 0, OLED_WIDTH, 22);
        u8g2_SetFont(&g_u8g2, cn_font_16);        // 中文点阵 16x16
        u8g2_SetDrawColor(&g_u8g2, 0);
        uint16_t title_x = (OLED_WIDTH - u8g2_GetUTF8Width(&g_u8g2, title)) / 2;
        u8g2_DrawUTF8(&g_u8g2, title_x, 19, title);
        u8g2_SetDrawColor(&g_u8g2, 1);

        // 内容区边框
        u8g2_DrawFrame(&g_u8g2, 0, 24, OLED_WIDTH, OLED_HEIGHT - 44);

        // 两行：选中项用 '*' 前缀标记（不用反白框，避免高亮框与上边线贴边）
        // 行距 32px、字体高 15px，两行在内容框内上下留白均衡
        u8g2_SetFont(&g_u8g2, cn_font_16);        // 两行含中文标签，改用中文点阵
        for (uint8_t i = 0; i < MOTOR_SPEED_ITEM_CNT; i++)
        {
            uint16_t row_y = 42 + (uint16_t)i * 32U;
            if (i != sel)
            {
                // 非光标行：留空
                snprintf(buf, sizeof(buf), " %s: %u 转", labels[i], (unsigned)vals[i]);
            }
            else if (editing)
            {
                // 光标行进入修改态：'>' 变为 '*'
                snprintf(buf, sizeof(buf), "*%s: %u 转", labels[i], (unsigned)vals[i]);
            }
            else
            {
                // 选择态：光标行用 '>'
                snprintf(buf, sizeof(buf), ">%s: %u 转", labels[i], (unsigned)vals[i]);
            }
            u8g2_DrawUTF8(&g_u8g2, 8, row_y, buf);
        }

        // 底部状态栏
        u8g2_DrawBox(&g_u8g2, 0, OLED_HEIGHT - 18, OLED_WIDTH, 18);
        u8g2_SetFont(&g_u8g2, cn_font_12);        // 底部状态栏中文小字
        u8g2_SetDrawColor(&g_u8g2, 0);
        if (oled_msg.type != OLED_MSG_NULL)
        {
            u8g2_DrawUTF8(&g_u8g2, (OLED_WIDTH - u8g2_GetUTF8Width(&g_u8g2, oled_msg.data)) / 2,
                          OLED_HEIGHT - 3, oled_msg.data);
        }
        else
        {
            u8g2_DrawUTF8(&g_u8g2, (OLED_WIDTH - u8g2_GetUTF8Width(&g_u8g2, status)) / 2,
                          OLED_HEIGHT - 3, status);
        }
        u8g2_SetDrawColor(&g_u8g2, 1);
    } while (u8g2_NextPage(&g_u8g2));
}

/**
 * @brief 保存当前速度设定到 FlashDB 并刷新 Modbus 保持寄存器
 */
static void save_motor_speed_config(void)
{
    sync_to_sysdb();   // 落 FlashDB，掉电保留
    sync_to_modbus();  // 刷新保持寄存器 209/210、211/212，供上位机读取
}

/**
 * @brief 电机速度设置页（选择态 / 修改态 两层）
 * @param title 页面标题
 */
static void edit_motor_speed_page(const char *title)
{
    uint16_t max_val = injector_config.maxMotorSpeed;
    uint16_t base_val = injector_config.baseMotorSpeed;
    uint8_t sel = MOTOR_SPEED_ITEM_MAX;      // 当前选中项
    uint8_t editing = 0U;                    // 0=选择态 1=修改态
    const char *status_sel = "旋转选择，按下修改，长按返回";
    const char *status_edit = "旋转调节，按下确认，长按返回";
    EncoderState st;
    uint8_t run = 1U;

    while (run)
    {
        draw_motor_speed_page(title, max_val, base_val, sel, editing,
                              editing ? status_edit : status_sel);
        if (edit_poll(&st) == 0U)
        {
            continue;
        }
        switch (st)
        {
        case ENCODER_CW:
        case ENCODER_CCW:
            if (editing)
            {
                // 修改态：旋转调值。
                // 上限按项区分：最大速度项用绝对上限 MOTOR_SPEED_MAX_RPM（否则以其自身为上限会被钳死、无法增大）；
                // 目标速度项以最大速度为上限，保证 base <= max。
                uint16_t limit = (sel == MOTOR_SPEED_ITEM_MAX) ? MOTOR_SPEED_MAX_RPM : max_val;
                if (limit < MOTOR_SPEED_MIN_RPM)
                {
                    limit = MOTOR_SPEED_MIN_RPM;
                }
                uint16_t *cur = (sel == MOTOR_SPEED_ITEM_MAX) ? &max_val : &base_val;
                if (st == ENCODER_CW)
                {
                    if (*cur <= limit - MOTOR_SPEED_STEP_RPM) *cur += MOTOR_SPEED_STEP_RPM;
                    else *cur = limit;
                }
                else
                {
                    if (*cur >= MOTOR_SPEED_MIN_RPM + MOTOR_SPEED_STEP_RPM) *cur -= MOTOR_SPEED_STEP_RPM;
                    else *cur = MOTOR_SPEED_MIN_RPM;
                }
                // 调小最大速度时若已低于目标速度，则同步压低目标速度，保持 base <= max
                if (sel == MOTOR_SPEED_ITEM_MAX && max_val < base_val)
                {
                    base_val = max_val;
                }
            }
            else
            {
                // 选择态：旋转在两项之间移动选择
                sel = (uint8_t)((sel + 1U) % MOTOR_SPEED_ITEM_CNT);
            }
            break;
        case ENCODER_PUTH:
            if (editing)
            {
                // 修改态短按：确认当前项并退回选择态
                if (sel == MOTOR_SPEED_ITEM_MAX)
                {
                    injector_config.maxMotorSpeed = max_val;
                }
                else
                {
                    injector_config.baseMotorSpeed = base_val;
                }
                save_motor_speed_config();
                show_oled_msg(OLED_MSG_UPDATE, "保存成功");
                editing = 0U;
            }
            else
            {
                // 选择态短按：进入当前项的修改态
                editing = 1U;
            }
            break;
        case ENCODER_PUTH_LONG:
            // 长按：直接返回上一级，不写 Flash（与波特率页一致，避免 FlashDB 写入延时）
            // 保存只由修改态短按确认完成；若调了值未短按确认就长按退出，改动不生效
            run = 0U;
            break;
        default:
            break;
        }
    }
}

