/**
 * @brief 编辑页事件轮询（100ms 节拍，仅驱动重绘；无空闲超时）
 * @param st 输出编码器事件
 * @retval 1=收到按键 0=无事件
 */
static uint8_t edit_poll(EncoderState *st)
{
    if (xQueueReceive(QUEUE_KEY, st, pdMS_TO_TICKS(100)) == pdPASS)
    {
        return 1U;
    }
    return 0U;
}

/**
 * @brief 波特率编辑页：6 档枚举，短按保存，长按返回
 */
static void edit_baud_page(void)
{
    uint8_t sel = 0U;
    char val_buf[40];
    const char *note = "设置后重启生效";
    const char *status = "旋转选择，按下保存，长按返回";
    EncoderState st;
    uint8_t run = 1U;

    for (uint8_t i = 0U; i < BAUD_SEL_CNT; i++)
    {
        if (s_baud_table[i] == main_config.BaudRate)
        {
            sel = i;
            break;
        }
    }

    while (run)
    {
        snprintf(val_buf, sizeof(val_buf), "波特率: %lu", (unsigned long)s_baud_table[sel]);
        draw_edit_page("串口设置", val_buf, note, status);
        if (edit_poll(&st) == 0U)
        {
            continue;
        }
        switch (st)
        {
        case ENCODER_CW:
            if (sel < BAUD_SEL_CNT - 1U) sel++;
            break;
        case ENCODER_CCW:
            if (sel > 0U) sel--;
            break;
        case ENCODER_PUTH:
            save_baudrate(s_baud_table[sel]);
            show_oled_msg(OLED_MSG_UPDATE, "保存成功");
            break;
        case ENCODER_PUTH_LONG:
            run = 0U;
            break;
        default:
            break;
        }
    }
}

