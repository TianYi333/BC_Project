            case ENCODER_CCW:
                zdt_run_motor_loc_rel(Q_MOTOR_ADDR, Q_MOTOR_IF, zdt_q_msg, Q_MOTOR_RATE, 0x01, MOTOR_RUN_CCW);
                angle = zdt_get_motor_loc_abs(Q_MOTOR_ADDR, Q_MOTOR_IF, zdt_q_msg, Q_MOTOR_RATE);
                show_q_model_init_page(&g_u8g2, angle, "就绪");
                show_q_model_init_page(&g_u8g2, angle, "就绪");
                break;

            default:
                break;
            }
