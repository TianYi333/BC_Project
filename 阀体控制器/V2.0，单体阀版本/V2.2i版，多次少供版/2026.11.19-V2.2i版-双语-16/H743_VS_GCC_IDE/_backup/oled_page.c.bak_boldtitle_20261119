                    show_q_model_init_page(&g_u8g2, angle, "保存成功");
                }
                else
                {
                    show_q_model_init_page(&g_u8g2, angle, "失败");
                }
                break;
            case ENCODER_CW:
                zdt_run_motor_loc_rel(Q_MOTOR_ADDR, Q_MOTOR_IF, zdt_q_msg, Q_MOTOR_RATE, 0x01, MOTOR_RUN_CW);
