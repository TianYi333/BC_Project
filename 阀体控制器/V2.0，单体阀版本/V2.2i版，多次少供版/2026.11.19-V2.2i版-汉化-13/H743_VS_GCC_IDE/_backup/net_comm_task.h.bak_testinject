//======================== 阀体供油策略（分次 / 离线自主注油 / 去重） =============================
// 网关下发 inj_v / total_x10 均已按阀体规格换算为设备单位（1ml 阀体：数值即 mL，亦即注油次数）；
// 固件不再做任何量程换算，收到即用。同一轮共享同一 task_id、各批以 sub_index 区分（契约 §5.1/§6.2）。
// 离线语义（两条路径互不重叠）：
//   ① 断连前已入 g_sched_list[] 的批次 —— 无论在线离线，到点只执行【本批次 inj_v】，不做整轮集中注油；
//   ② 离线"一次性整轮注油" —— 由 g_offline_round_sched[]（按注油点分槽，每点一份）按 adj_period_sec 周期自主注 total_x10（见下方说明）。
#define SCHED_MAX           24      // 分次调度表容量：同时"挂起（未执行完）"的子任务份数上限。
                                    // 任一格执行完毕后即由调度器回收 valid=0，腾出空位供后续批次使用；
                                    // 故 24 表达的是"同时在途份数"，而非"设备一生累计份数"。
#define DEDUP_RING_MAX      48      // 去重环形缓冲容量（复合键 task_id + sub_index，纯 RAM，断线不断电）。复合键为必需：同一轮共享 task_id、各批以 sub_index 区分，单 task_id 键会误杀正常轮内第 2..K 批；另可拦下 generateTaskID 同纳秒碰撞产生的同 key 轮次（偏安全漏注）。仅真正重传（task_id 与 sub_index 均同）被拦下
#define OFFLINE_ROUND_SLOTS INJECTOR_CNT // 离线轮次计划分槽数（= 注油点数量 8），按 inj_id-1 索引；每槽一份、互不覆盖（2026-10-30）

// 分次任务调度表项（task_type=3 进入，由 task_scheduler_task 到点触发执行）
// 触发顺序：调度器每拍从所有"已到点"表项中选 exec_at 最早者触发（exec_at==0 视为立即执行、键=0 排最前；
// exec_at 相同按下标小者优先，保持稳定）。故执行顺序由 exec_at 决定，与入表顺序、槽位复用无关。
typedef struct
{
    uint8_t  valid;          // 1=表项有效（占用）；执行完毕由调度器回收置 0，腾出空位供后续批次使用
    uint8_t  done;           // 1=已触发执行（该批已下发给注油驱动）；与 valid=0 配合实现回收
    uint16_t inj_id;
    uint32_t inj_v;          // 单份注油量（mL）
    char     task_id[TASK_ID_LEN];
    uint32_t exec_at;        // 应当执行时刻（绝对 Unix 秒）；0=立即执行
    uint16_t sub_index;
    uint16_t sub_total;
} SplitTaskSched_t;

// 去重键：同一子任务（task_id + sub_index）重传时跳过，防止重复注油（契约 §4.2-6 / §6.2）
// 注意：去重键含 sub_index，否则同一轮 K 份（同 task_id 不同 sub_index，见 §5.1）会被误杀。
typedef struct
{
    char     task_id[TASK_ID_LEN];
    uint16_t sub_index;
} DedupKey_t;

// 离线轮次计划（每注油点一份）：在线收到分次批（task_type=3）时，按 inj_id-1 捕获【该注油点】的轮次配置，
// 供离线期按 adj_period_sec 周期自主一次性注整轮（契约 §6.9）。
// 2026-10-30 由单实例改为 8 槽数组：原实现只有一份全局配置，8 个注油点各自下发分次批时会因 task_id 变化
//   互相整份覆盖，最终只剩最后一个点保有离线自注油能力，其余 7 点离线期完全不注油。
// 现每点一份、互不覆盖；轮界以【本槽自己的 task_id】判定（首次见到 = 该点新一轮起点，last_fire_unix），
//   迟到的 sub_index==1 用其 exec_at 校正。故同时兼容"一个 task_id 跨多点"与"每点独立 task_id"两种下发风格。
// 职责边界：本结构【只】负责"离线状态下按时间间隔不分批次自主注油"；
// 已入 g_sched_list[] 的批次由调度器逐批正常执行（不论在线离线），两者互不重叠、不会重复注油。
typedef struct
{
    uint8_t  valid;          // 1=有有效轮次配置（在线收到过 task_type=3 批）
    uint16_t inj_id;
    uint32_t total_x10;      // 整轮总注油量（网关已换算，数值即整轮注油次数）
    uint32_t adj_period_sec; // 整轮间隔（s），驱动离线自行注油周期
    char     task_id[TASK_ID_LEN];
    uint32_t last_fire_unix; // 轮次参考时刻（绝对 Unix 秒）。
                           // 在线捕获 = 首批发 exec_at（本轮起点，用于推算下一轮何时自行注）；
                           // 离线每次周期触发后置 = now（实际触发时刻），【绝不】用 += adj_period_sec。
                           // 理由：若离线/繁忙使 now 跨过多个周期，= now 把参考拉到真实此刻、丢弃欠账
                           // （每空隙最多注 1 次，宁可少注不补）；+= period 会逐拍把漏掉的轮次连续补注
                           // （爆发超注），对油泵危险。故采用 = now（间隔只长不短、防爆发）。
} OfflineRoundSched_t;

// 槽3 当前执行份的回报上下文：解决分次多份共用全局 g_tcp_task_bind 导致的串台问题（契约 §4.1-4）
typedef struct
{
    uint8_t  valid;          // 1=有有效上下文
    char     task_id[TASK_ID_LEN];
    uint16_t inj_id;
